# eq-sparks runtime "OS" — never committed in consumer repos.
# In consumer repos the whole .eq-sparks/ tree is gitignored; here in the
# central repo we only ignore the per-run runtime state, not the source.
.eq-sparks/cache/
.eq-sparks/agent-memory/
.eq-sparks/runs/
.eq-sparks/telemetry/
.eq-sparks/artifacts/

# Per-developer config (the .example is committed; the real one is not)
.eq-sparks.yml

# OS / editor noise
.DS_Store
*.log
node_modules/
